# Travelpayouts / Aviasales Data API. Leave blank to start in provider-unavailable mode.
TRAVELPAYOUTS_TOKEN=
# Optional affiliate marker, used only when a provider result exposes a valid search token.
TRAVELPAYOUTS_MARKER=

# Development-only. Never enabled automatically when the real provider is unavailable.
USE_MOCK_TRAVEL_PROVIDER=false
PORT=4100

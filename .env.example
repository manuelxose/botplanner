# Travelpayouts / Aviasales Data API. Leave blank to start in provider-unavailable mode.
TRAVELPAYOUTS_TOKEN=
# Optional affiliate marker, used only when a provider result exposes a valid search token.
TRAVELPAYOUTS_MARKER=
AVIASALES_SEARCH_API_ENABLED=false
# Optional live validation. Leave blank to expose Skyscanner Live as UNAVAILABLE.
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=ES
SKYSCANNER_LOCALE=es-ES
SKYSCANNER_CURRENCY=EUR
MAX_RETURN_AIRPORT_CANDIDATES=4
MAX_OPEN_JAW_COMBINATIONS=12
MAX_LIVE_FLIGHT_ENRICHMENTS=5
MAX_MULTI_CITY_CANDIDATES=3

# Development-only. Never enabled automatically when the real provider is unavailable.
USE_MOCK_TRAVEL_PROVIDER=false
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_API_ENV=sandbox
USE_MOCK_ACCOMMODATION_PROVIDER=false
MAX_ACCOMMODATION_ENRICHMENTS=10
PROVIDER_MAX_CONCURRENCY=4
ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
MAPBOX_ACCESS_TOKEN=
MAX_ROADTRIP_BASE_CANDIDATES=8
MAX_ROADTRIP_VARIANTS_PER_TRIP=3
MAX_ROADTRIP_STOPS=4
MAX_ROADTRIP_ENRICHMENTS=5
FUEL_LITRES_PER_100KM=6.5
FUEL_PRICE_PER_LITRE_EUR=1.70
PORT=4100
